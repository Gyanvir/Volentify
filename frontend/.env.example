# Copy to frontend/.env (local) or set in Vercel → Project → Settings → Environment Variables.
# Without DATABASE_URL the live hazard feeds still show, but nothing created locally is stored ("Not saved").
# With DATABASE_URL set, the API creates the tables and applies migrations itself. No sample data is ever inserted.

# ─── Database: Neon PostgreSQL (Vercel → Storage → neon-volentify) ──────────
# Copy both strings from Vercel (Storage → neon-volentify → .env.local) or run: vercel env pull frontend/.env
# Pooled connection (host contains "-pooler"). Also read from DB_URL, POSTGRES_URL or DB_POSTGRES_URL — the names
# Vercel's Neon integration uses — so whichever prefix was chosen when connecting the database works.
DATABASE_URL="postgresql://{user}:{password}@ep-{name}-pooler.{region}.aws.neon.tech/neondb?sslmode=require"
# Unpooled connection (DATABASE_URL_UNPOOLED in Vercel) for prisma db push and npm run db:seed.
DIRECT_URL=""

# ─── Live feeds ─────────────────────────────────────────────────────────────
# Set to 1 to stop all outbound calls to GDACS, USGS, NASA EONET, NDMA SACHET and OpenStreetMap (tests do this).
VOLENTIFY_OFFLINE=""

# ─── Sessions ───────────────────────────────────────────────────────────────
# Signs session cookies and mesh gateway tokens. Strongly recommended; if absent, a key is derived from the
# database connection string (changing the database password then signs everyone out).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated emails that become verified incident administrators on sign-up.
VOLENTIFY_ADMIN_EMAILS=""

# ─── Google OAuth 2.0 ───────────────────────────────────────────────────────
# Authorised redirect URI in Google Cloud Console: {NEXTAUTH_URL}/auth/callback
GOOGLE_CLIENT_ID=""

# ─── AI / ML (all optional — deterministic fallbacks run without them) ──────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"   # retired models are replaced automatically
IMPOSSIBL_API_KEY=""
IMPOSSIBL_API_URL="https://api.impossibl.com/v1/triage"

# ─── Volentify Mesh Android app ─────────────────────────────────────────────
# Shown as "Download the Android app"; the GitHub workflow publishes it at this address.
NEXT_PUBLIC_MESH_APK_URL="https://github.com/Gyanvir/Volentify/releases/latest/download/volentify-mesh.apk"

NEXT_TELEMETRY_DISABLED=1
