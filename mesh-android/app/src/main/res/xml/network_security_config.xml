<?xml version="1.0" encoding="utf-8"?>
<!--
  Reports, gateway tokens and command messages only travel encrypted, and only to servers whose certificate is
  trusted by Android itself: a certificate a user (or an attacker with brief access to the phone) installs cannot be
  used to read or alter the app's traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- A developer's own machine (the emulator host, or adb reverse) may use plain http for local testing. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
